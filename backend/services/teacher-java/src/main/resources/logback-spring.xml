<?xml version="1.0" encoding="UTF-8"?>
<!--
  ESP 统一 logback 配置(Phase2 升级:logstash-logback-encoder 结构化 JSON)。
  OTel javaagent 自动写 MDC: trace_id / span_id / trace_flags。
  LogstashEncoder 输出标准 ELK JSON,含 exception stack trace + MDC 全字段。
  适用服务:bff-java / learning-java / teacher-java(三服务共用此模板)。

  依赖:com.github.logstash.logback:logstash-logback-encoder:7.4
  (需在各服务 pom.xml 中添加,见 Phase2 任务清单)
-->
<configuration>
    <springProfile name="default | dev | test">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [traceId=%X{trace_id} spanId=%X{span_id}] - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="prod | staging">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <!-- 输出字段定制:含 trace/span 关联 + 精简 timestamp -->
                <includeMdcKeyName>trace_id</includeMdcKeyName>
                <includeMdcKeyName>span_id</includeMdcKeyName>
                <fieldNames>
                    <timestamp>[ignore]</timestamp>
                    <version>[ignore]</version>
                </fieldNames>
                <customFields>{"service":"${spring.application.name:-esp-java}"}</customFields>
                <!-- 日期格式:ISO-8601 带时区 -->
                <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSZ</timestampPattern>
            </encoder>
        </appender>
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.esp" level="INFO"/>
    </springProfile>
</configuration>
