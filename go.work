// ESP Go workspace(会话22-3 债1+2):统一本地解析 esp/common-go 与 7 Go 服务。
// 注意:go.work 不进 Docker 构建上下文(各服务 Dockerfile 仅 COPY 自身目录),
// 容器内靠各 go.mod 的 replace esp/common-go => ../esp-common-go 解析;本地 IDE/编译靠本 go.work。
go 1.25.0

use (
	./services/esp-common-go
	./services/conversation-go
	./services/gateway-go
	./services/course-path-go
	./services/listening-go
	./services/reading-go
	./services/gamification-go
	./services/live-tutor-go
	./services/vocab-srs-go
)
