<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.esp</groupId>
    <artifactId>esp-cache</artifactId>
    <version>1.0.0</version>
    <name>esp-cache</name>
    <packaging>jar</packaging>
    <description>
        ESP 共用多级缓存工具包(ADR-多级缓存):L1 Caffeine + L2 Redis + Pulsar 跨实例失效广播 + 延迟双删 + TTL 兜底 + 防穿透。
        供 learning-java / bff-java / teacher-java 等所有 Java 服务复用,Cache-Aside 手动模式(精确控制 L1/L2 + 广播)。
        feature flag:esp.cache.enabled=false 时全部 no-op 直打 DB(回退安全)。
    </description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>4.0.7</spring-boot.version>
        <spring.version>7.0.8</spring.version>
        <caffeine.version>3.2.4</caffeine.version>
        <pulsar.version>3.3.9</pulsar.version>
        <slf4j.version>2.0.18</slf4j.version>
        <jackson.version>2.19.4</jackson.version>
        <junit.version>5.14.4</junit.version>
        <mockito.version>5.18.0</mockito.version>
    </properties>

    <dependencies>
        <!-- spring-cache 抽象 + Caffeine provider:scope=provided,使用方(spring-boot 工程)自带 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>${spring.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
            <version>${spring-boot.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>${caffeine.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <version>${spring-boot.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.pulsar</groupId>
            <artifactId>pulsar-client</artifactId>
            <version>${pulsar.version}</version>
            <exclusions>
                <!-- 排除 pulsar 内嵌的 bouncy-castle-bc:pkg(内含 bcprov 1.78.1,修复 CRIT CVE-2025-14813);
                     由各服务显式声明的 bcprov-jdk18on 1.84 替代 -->
                <exclusion>
                    <groupId>org.apache.pulsar</groupId>
                    <artifactId>bouncy-castle-bc</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>3.0.0</version>
        </dependency>
        <!-- P1-8 写接口幂等:IdempotencyFilter / IdempotentResponseWrapper 依赖 jakarta.servlet。
             scope=provided,使用方(spring-boot-starter-web 工程)自带 servlet-api。 -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- spring-web 提供 OncePerRequestFilter(servlet 抽象,Filter 基类)。scope=provided。 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <version>${spring.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- spring-test 提供 MockHttpServletRequest/Response(用于 IdempotencyFilter 单测) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <version>${spring.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
