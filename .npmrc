# Taro 小程序工具链对 pnpm 符号链接隔离不兼容(webpack5 resolve 跟踪 symlink 失败),
# 用 hoisted 把依赖拍平到 node_modules 根,兼容 Taro/antd-mobile 等对 node_modules 结构敏感的包。
node-linker=hoisted
# 共享包 workspace 协议(@esp/*)走 pnpm link
link-workspace-packages=true
# 优先用 workspace 内的包,避免误装同名 npm 包
prefer-workspace-packages=true
# 国内镜像加速(单节点环境 npm 直连慢)
registry=https://registry.npmmirror.com/
