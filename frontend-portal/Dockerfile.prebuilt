# frontend-portal 派生构建 —— 绕开华为云 nginx mirror 403。
# 流程:FROM 既有 portal 镜像(已含 nginx:1.27-alpine 基础层)COPY nginx.conf + index.html 覆盖。
# 基础层:esp/frontend-portal:1.3.5(mirror 挂时用此派生,合规打非标 tag 避免 tag 劫持)。
FROM esp/frontend-portal:1.3.5
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY index.html /usr/share/nginx/html/index.html
EXPOSE 80
