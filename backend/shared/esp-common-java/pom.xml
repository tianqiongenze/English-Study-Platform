<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.esp</groupId>
    <artifactId>esp-common-java</artifactId>
    <version>1.0.0</version>
    <name>esp-common-java</name>
    <packaging>jar</packaging>
    <description>
        ESP 共用 Java 基础能力包(铁律一:公共能力共享包优先):
        1) BaseJwtValidator -- RS256 公钥校验 JWT(learning-java/teacher-java 共用,消除 auth/JwtValidator 重复)。
        2) BaseJwtAuthFilter -- JWT 鉴权 Filter(OncePerRequestFilter,白名单/bearer 校验/userId 注入)。
        3) HealthConfig -- 健康端点白名单常量(消除各服务 Filter/Handler 重复定义)。
        4) SentinelRuleBootstrap -- Sentinel 规则启动兜底重拉(NacosDataSource 时序 bug workaround)。
        5) CockroachDbConfig -- CRDB 双池数据源(写池/读池/共享池,收编自 learning-java SharedDataSourceConfig)。
        供 bff-java / learning-java / teacher-java 等所有 Java 服务复用。
    </description>

    <properties>
        <maven.compiler.source>26</maven.compiler.source>
        <maven.compiler.target>26</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jjwt.version>0.13.0</jjwt.version>
        <spring-boot.version>4.0.7</spring-boot.version>
        <jackson.version>2.21.4</jackson.version>
    </properties>

    <dependencies>
        <!-- JWT 校验(JJWT:RS256 公钥验签名 + Claims 解析) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Spring Framework: @Component / @Configuration / @Value / @EventListener -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>7.0.8</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
            <version>${spring-boot.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta Servlet API(BaseJwtAuthFilter:OncePerRequestFilter / HttpServletRequestWrapper) -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.1.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- Spring Web(BaseJwtAuthFilter:OncePerRequestFilter) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <version>7.0.8</version>
            <scope>provided</scope>
        </dependency>

        <!-- Sentinel: FlowRuleManager / DegradeRuleManager(SentinelRuleBootstrap) -->
        <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-core</artifactId>
            <version>1.8.8</version>
            <scope>provided</scope>
        </dependency>
        <!-- Jackson: SentinelRuleBootstrap 反序列化 nacos config -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- SLF4J -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.18</version>
            <scope>provided</scope>
        </dependency>

        <!-- esp-rw-java:CockroachDbDataSourceProperties(读写分离属性,CockroachDbConfig 依赖) -->
        <dependency>
            <groupId>com.esp</groupId>
            <artifactId>esp-rw-java</artifactId>
            <version>1.0.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- HikariCP:CockroachDbConfig 直接 import com.zaxxer.hikari.*(esp-rw-java 将 hikari 声明为 provided
             故不传递;esp-common-java 直接使用须显式声明,与 esp-rw-java 6.3.3 对齐)。 -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>6.3.3</version>
            <scope>provided</scope>
        </dependency>

        <!-- test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.14.4</version>
            <scope>test</scope>
        </dependency>
        <!-- jjwt 已在上方声明为 provided(provided 同时覆盖 compile+test classpath,无需 test 重复声明;
             重复 test 声明会触发 Maven 重复解析覆盖,导致 main 源码编译期 io.jsonwebtoken not found)。 -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.18.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <version>${spring-boot.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution><id>prepare-agent</id><goals><goal>prepare-agent</goal></goals></execution>
                    <execution><id>report</id><phase>test</phase><goals><goal>report</goal></goals></execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
